{
  "name": "schoolpot",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:db": "node tests/database/run.mjs",
    "test:pwa": "playwright test --config playwright.pwa.config.js",
    "test:edge": "npx --yes deno@2.9.6 test --config supabase/functions/push-dispatch/deno.json --allow-env tests/edge supabase/functions/_shared/http_test.ts",
    "prebuild": "node scripts/verify-glob-patch.mjs",
    "verify:glob-patch": "node scripts/verify-glob-patch.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "markdown-it": "15.0.3",
    "parse5": "8.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0",
    "eslint": "9.39.5",
    "prettier": "3.10.0",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "picomatch": "file:vendor/picomatch"
  },
  "overrides": {
    "picomatch": "$picomatch"
  }
}
